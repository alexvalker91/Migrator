<configuration>
    <!-- Global logging for third-party libraries (LangChain4j request/response logs, MCP SDK).
         Migration session logs use a private context in LogbackMigrationLogger. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- LangChain4j logs full HTTP requests/responses (prompts, base64 screenshots) at INFO because the DIAL
         contract sets logRequests/logResponses: keep them off the console; LlmWireLog routes them to
         migration_reports/<Class>/llm_wire.log when -Dmigration.llm.wireLog=true. -->
    <logger name="dev.langchain4j" level="WARN"/>
    <logger name="io.modelcontextprotocol" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
