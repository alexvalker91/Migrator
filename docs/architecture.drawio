c;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1540" y="1264" width="560" height="70" as="geometry"/></mxCell><mxCell id="p2-27" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#888888;strokeWidth=1.2;fontSize=10;dashed=1;" edge="1" parent="1" source="s-4" target="r-fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-rep" value="&lt;b&gt;migration_reports/&amp;lt;Class&amp;gt;/&lt;/b&gt;&lt;br&gt;dashboard.html, report.md, execution.log, llm_calls.jsonl, walkthroughs/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1540" y="1409" width="560" height="70" as="geometry"/></mxCell><mxCell id="p2-28" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#888888;strokeWidth=1.2;fontSize=10;dashed=1;" edge="1" parent="1" source="s-5" target="r-rep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-hist" value="&lt;b&gt;.migration/history/runs.jsonl&lt;/b&gt;&lt;br&gt;строка на класс → проекция на 1200+ тестов" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1540" y="1491" width="560" height="70" as="geometry"/></mxCell><mxCell id="p2-29" value="append/read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#888888;strokeWidth=1.2;fontSize=10;dashed=1;" edge="1" parent="1" source="s-5" target="r-hist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;Толстая стрелка вниз — переход между этапами. Пунктир влево — LLM-ярус этапа. Пунктир вправо — хранилище или внешняя система.&lt;br&gt;Коды выхода: 0 SUCCESS, 1 COMPLETED_WITH_MANUAL_FIX, 2 STAGE5_FAILED, 3 ABORTED, 64 ошибка использования, 70 сбой инфраструктуры.&lt;br&gt;Порядок этапов в коде: 1 → 2 → 0 → 3 → 4 → 5 (Этап 0 идёт после Этапа 2, ему нужны снятые слепки)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="560" y="1616" width="900" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>