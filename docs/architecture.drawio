<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0"><diagram name="Слои и Классы" id="p1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3300" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-ext" value="Внешний мир" style="swimlane;horizontal=1;startSize=34;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#f5f5f5;opacity=60;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="2860" y="736" width="350" height="543" as="geometry"/></mxCell><mxCell id="lane-inf" value="INFRASTRUCTURE — адаптеры портов (LangChain4j, MCP SDK, JavaParser, Jackson, git, Maven)" style="swimlane;horizontal=1;startSize=34;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#d5e8d4;opacity=60;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="500" y="736" width="2740" height="543" as="geometry"/></mxCell><mxCell id="lane-port" value="DOMAIN.PORT — интерфейсы (15 портов; *Port, зависимости от библиотек запрещены ArchUnit)" style="swimlane;horizontal=1;startSize=34;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fff2cc;opacity=60;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="500" y="546" width="2740" height="140" as="geometry"/></mxCell><mxCell id="lane-app" value="APPLICATION — сценарии использования (зависят только от domain и JDK)" style="swimlane;horizontal=1;startSize=34;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#dae8fc;opacity=60;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="2740" height="416" as="geometry"/></mxCell><mxCell id="lane-domain" value="DOMAIN — сущности и value objects (без внешних библиотек)" style="swimlane;horizontal=1;startSize